generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublicationType {
  RESEARCH_PAPER
  JOURNAL
  POLICY_BRIEF
  REPORT
}

enum PublicationStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Publication {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  abstract        String            @db.Text
  description     String?           @db.Text
  type            PublicationType
  status          PublicationStatus @default(DRAFT)
  publicationDate DateTime?
  year            Int?
  coverImageUrl   String?
  pdfUrl          String?
  pdfFileName     String?
  pdfFileSize     Int?
  pdfMimeType     String?
  doi             String?
  downloadCount   Int               @default(0)

  coverImageAssetId String?
  coverImageAsset   MediaAsset? @relation("PublicationCoverAsset", fields: [coverImageAssetId], references: [id], onDelete: Restrict)
  pdfAssetId        String?
  pdfAsset          MediaAsset? @relation("PublicationPdfAsset", fields: [pdfAssetId], references: [id], onDelete: Restrict)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  journalIssueId String?
  journalIssue   JournalIssue? @relation(fields: [journalIssueId], references: [id], onDelete: SetNull)

  authors PublicationAuthor[]
  tags    PublicationTag[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model Author {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  biography    String?             @db.Text
  affiliation  String?
  position     String?
  photoUrl     String?
  photoAssetId String?
  photoAsset   MediaAsset?         @relation("AuthorPhotoAsset", fields: [photoAssetId], references: [id], onDelete: Restrict)
  email        String?
  publications PublicationAuthor[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model PublicationAuthor {
  publicationId String
  authorId      String
  order         Int    @default(0)

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  author      Author      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([publicationId, authorId])
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  description  String?       @db.Text
  publications Publication[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Tag {
  id           String           @id @default(cuid())
  name         String           @unique
  slug         String           @unique
  publications PublicationTag[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model PublicationTag {
  publicationId String
  tagId         String

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([publicationId, tagId])
}

enum JournalStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Journal {
  id                String         @id @default(cuid())
  title             String
  slug              String         @unique
  description       String?        @db.Text
  status            JournalStatus  @default(DRAFT)
  coverImageUrl     String?
  coverImageAssetId String?
  coverImageAsset   MediaAsset?    @relation("JournalCoverAsset", fields: [coverImageAssetId], references: [id], onDelete: Restrict)
  issues            JournalIssue[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
}

model JournalIssue {
  id                String        @id @default(cuid())
  journalId         String
  journal           Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  volume            Int
  issue             Int
  title             String
  description       String?       @db.Text
  status            JournalStatus @default(DRAFT)
  coverImageUrl     String?
  coverImageAssetId String?
  coverImageAsset   MediaAsset?   @relation("JournalIssueCoverAsset", fields: [coverImageAssetId], references: [id], onDelete: Restrict)
  pdfUrl            String?
  pdfAssetId        String?
  pdfAsset          MediaAsset?   @relation("JournalIssuePdfAsset", fields: [pdfAssetId], references: [id], onDelete: Restrict)
  publishedAt       DateTime?
  publications      Publication[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([journalId, volume, issue])
  @@index([journalId, status])
  @@index([publishedAt])
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  INQUIRY_MANAGER
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

model AdminUser {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  passwordHash        String
  role                AdminRole   @default(EDITOR)
  status              AdminStatus @default(ACTIVE)
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  sessions             AdminSession[]
  assignedInquiries    ContactInquiry[]     @relation("AssignedInquiries")
  inquiryNotes         InquiryNote[]
  inquiryActivities    InquiryActivity[]
  inquiryReplies       InquiryReply[]
  subscriberActivities SubscriberActivity[]
  uploadedMedia        MediaAsset[]         @relation("AdminUploadedMedia")

  @@index([email])
  @@index([role])
  @@index([status])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tokenHash])
  @@index([adminUserId])
  @@index([expiresAt])
}

model RateLimitRecord {
  id        String   @id @default(cuid())
  keyHash   String   @unique
  points    Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([keyHash])
  @@index([expiresAt])
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  AWAITING_RESPONSE
  RESOLVED
  SPAM
  ARCHIVED
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ContactInquiry {
  id              String          @id @default(cuid())
  referenceNumber String          @unique
  inquiryType     String
  fullName        String
  email           String
  phone           String?
  organization    String?
  subject         String?
  message         String          @db.Text
  sourceForm      String          @default("CONTACT_PAGE")
  status          InquiryStatus   @default(NEW)
  priority        InquiryPriority @default(MEDIUM)

  assignedToId String?
  assignedTo   AdminUser? @relation("AssignedInquiries", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  notes      InquiryNote[]
  activities InquiryActivity[]
  replies    InquiryReply[]

  @@index([email])
  @@index([status])
  @@index([inquiryType])
  @@index([createdAt])
  @@index([assignedToId])
  @@index([referenceNumber])
  @@index([priority])
}

model InquiryNote {
  id          String         @id @default(cuid())
  inquiryId   String
  inquiry     ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  adminUserId String
  adminUser   AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  content     String         @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([inquiryId])
  @@index([adminUserId])
  @@index([createdAt])
}

model InquiryActivity {
  id          String         @id @default(cuid())
  inquiryId   String
  inquiry     ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  adminUserId String?
  adminUser   AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  details     String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([inquiryId])
  @@index([adminUserId])
  @@index([createdAt])
}

enum EmailStatus {
  PENDING
  PROCESSING
  ACCEPTED_BY_SMTP
  FAILED
  CANCELLED
}

model EmailOutbox {
  id             String      @id @default(cuid())
  idempotencyKey String      @unique
  recipientEmail String
  recipientName  String?
  subject        String
  textBody       String      @db.Text
  htmlBody       String?     @db.Text
  category       String      @default("GENERAL")
  status         EmailStatus @default(PENDING)
  attemptCount   Int         @default(0)
  maxAttempts    Int         @default(5)
  scheduledAt    DateTime    @default(now())
  nextRetryAt    DateTime?
  lockedAt       DateTime?
  lockedBy       String?
  claimToken     String?
  acceptedAt     DateTime?
  failedAt       DateTime?
  lastError      String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  inquiryReply InquiryReply?

  @@index([status, scheduledAt, nextRetryAt])
  @@index([status, lockedAt])
  @@index([recipientEmail])
  @@index([category])
  @@index([createdAt])
}

model InquiryReply {
  id             String         @id @default(cuid())
  inquiryId      String
  inquiry        ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  adminUserId    String?
  adminUser      AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  authorName     String?
  authorEmail    String?
  recipientEmail String
  subject        String
  content        String         @db.Text
  outboxId       String?        @unique
  outbox         EmailOutbox?   @relation(fields: [outboxId], references: [id], onDelete: SetNull)
  idempotencyKey String         @unique
  status         EmailStatus    @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([inquiryId])
  @@index([adminUserId])
  @@index([createdAt])
  @@index([status])
}

enum SubscriberStatus {
  PENDING_VERIFICATION
  ACTIVE
  UNSUBSCRIBED
  SUPPRESSED
}

enum SubscriptionTokenType {
  VERIFICATION
  UNSUBSCRIBE
}

model NewsletterSubscriber {
  id                String           @id @default(cuid())
  email             String
  normalizedEmail   String           @unique
  status            SubscriberStatus @default(PENDING_VERIFICATION)
  source            String           @default("FOOTER")
  subscribedAt      DateTime         @default(now())
  verifiedAt        DateTime?
  unsubscribedAt    DateTime?
  suppressedAt      DateTime?
  suppressionReason String?
  deletedAt         DateTime?
  anonymizedAt      DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tokens     NewsletterSubscriptionToken[]
  consents   NewsletterConsent[]
  activities SubscriberActivity[]

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([normalizedEmail])
}

model NewsletterSubscriptionToken {
  id           String                @id @default(cuid())
  subscriberId String
  subscriber   NewsletterSubscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tokenHash    String                @unique
  type         SubscriptionTokenType
  expiresAt    DateTime
  usedAt       DateTime?
  ipHash       String?
  userAgent    String?
  createdAt    DateTime              @default(now())

  @@index([tokenHash])
  @@index([subscriberId, type])
  @@index([expiresAt])
}

model NewsletterConsent {
  id            String               @id @default(cuid())
  subscriberId  String
  subscriber    NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  consentType   String               @default("NEWSLETTER_SUBSCRIPTION")
  consentText   String               @db.Text
  policyVersion String               @default("v1.0")
  ipHash        String?
  userAgent     String?
  sourceUrl     String?
  createdAt     DateTime             @default(now())

  @@index([subscriberId])
  @@index([createdAt])
}

model SubscriberActivity {
  id           String               @id @default(cuid())
  subscriberId String
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  adminUserId  String?
  adminUser    AdminUser?           @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action       String
  details      String?              @db.Text
  createdAt    DateTime             @default(now())

  @@index([subscriberId])
  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

enum MediaAssetType {
  IMAGE
  DOCUMENT
}

enum MediaProvider {
  CLOUDINARY
}

enum MediaAssetStatus {
  UPLOADED
  ATTACHED
  ARCHIVED
  DELETED
}

model MediaAsset {
  id               String           @id @default(cuid())
  publicId         String           @unique
  mediaType        MediaAssetType
  provider         MediaProvider    @default(CLOUDINARY)
  secureUrl        String
  originalFilename String
  format           String
  mimeType         String
  bytes            Int
  width            Int?
  height           Int?
  pages            Int?
  checksumSha256   String?
  folder           String
  status           MediaAssetStatus @default(UPLOADED)

  uploadedById String?
  uploadedBy   AdminUser? @relation("AdminUploadedMedia", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publicationCovers  Publication[]  @relation("PublicationCoverAsset")
  publicationPdfs    Publication[]  @relation("PublicationPdfAsset")
  journalCovers      Journal[]      @relation("JournalCoverAsset")
  journalIssueCovers JournalIssue[] @relation("JournalIssueCoverAsset")
  journalIssuePdfs   JournalIssue[] @relation("JournalIssuePdfAsset")
  authorPhotos       Author[]       @relation("AuthorPhotoAsset")

  @@index([status, createdAt])
  @@index([uploadedById])
  @@index([checksumSha256])
  @@index([folder])
}

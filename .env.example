DATABASE_URL="postgresql://user:password@ep-instance-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

APP_URL="https://aipp-institute.org"
NEXT_PUBLIC_APP_URL="https://aipp-institute.org"
ALLOWED_ORIGINS="https://aipp-institute.org,https://www.aipp-institute.org"

RATE_LIMIT_SALT="replace_with_64_char_hex_random_salt_in_production"
CRON_SECRET="replace_with_32_char_cryptographically_secure_token"
TRUSTED_PROXY_HEADER="cf-connecting-ip"
TRUSTED_PROXY_HOPS="1"

CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloudinary_cloud_name"

SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASSWORD="your_smtp_production_password"
SMTP_PASS="your_smtp_production_password"
SMTP_FROM="AIPP Secretariat <secretariat@aipp-institute.org>"
SMTP_FROM_NAME="Athena Institute for Political Praxis"
SMTP_FROM_EMAIL="secretariat@aipp-institute.org"
INQUIRY_NOTIFICATION_EMAIL="directorate@aipp-institute.org"
EMAIL_FROM="secretariat@aipp-institute.org"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="your_smtp_production_password"
SMTP_CONNECTION_TIMEOUT_MS="10000"
SMTP_GREETING_TIMEOUT_MS="10000"
SMTP_SOCKET_TIMEOUT_MS="15000"
SMTP_SEND_TIMEOUT_MS="15000"
SMTP_RATE_LIMIT="5"
SMTP_RATE_DELTA_MS="1000"
SMTP_MAX_CONNECTIONS="5"
SMTP_MAX_MESSAGES="100"
SMTP_ALLOW_INSECURE="false"
SMTP_IGNORE_TLS_ERRORS="false"
SMTP_TEST_RECIPIENT="operations-test@aipp-institute.org"

AIPP_INQUIRY_EMAILS_ENABLED="true"
AIPP_INQUIRY_REPLIES_ENABLED="true"
AIPP_EMAIL_ROLLOUT_TIMESTAMP="2026-11-20T00:00:00.000Z"
AIPP_NEWSLETTER_RATE_LIMIT_POINTS="5"
AIPP_NEWSLETTER_RATE_LIMIT_WINDOW_SECONDS="600"
NODE_ENV="production"

